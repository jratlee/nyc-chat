OPENAI_API_KEY=sk-your-openai-api-key
OLLAMA_MODEL=qwen2.5
CYPHER_MODEL=gpt-4o-mini
SYNTHESIS_MODEL=gpt-4o

# Database Configuration (Use AuraDB URI for Cloud, localhost for Docker)
NEO4J_URI=neo4j+s://<your-hash>.databases.neo4j.io 
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-password

# Vector index dimension. Must match the embedding model used to build the index.
# OpenAI text-embedding-3-small = 1536.
EMBEDDING_DIM=1536

# Ingestion: max XML files per source (NYC1/NYC2/NYC3). 0 = process all files.
MAX_FILES_PER_SOURCE=20

# FastAPI CORS: comma-separated allowed origins for the frontend.
# Use "*" to allow any origin (disables credentials per the CORS spec).
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
# Optional regex for dynamic origins (e.g. Codespaces/forwarded URLs):
# CORS_ORIGIN_REGEX=https://.*\.app\.github\.dev

# Max number of cached query entries (LRU eviction beyond this).
CACHE_MAX_ENTRIES=500
